---
import Icon from './Icon.astro';
import type { IconName } from './Icon.astro';
import QuarksFooter from './QuarksFooter.astro';
import { PHONE, SITE, waLink } from '../lib/site';

const links: { icon: IconName; label: string; href: string; color: string; alpha?: number; wa?: boolean }[] = [
  { icon: 'whatsapp', label: 'WhatsApp', href: waLink(), color: '37 211 102', wa: true },
  { icon: 'instagram', label: 'Instagram', href: SITE.instagram, color: '225 48 108' },
  { icon: 'locationDot', label: 'Hurlingham, Buenos Aires', href: SITE.maps, color: '255 255 255', alpha: 0.54 },
  { icon: 'skull', label: 'Inspirado en One Piece', href: SITE.onePieceWiki, color: '255 255 255', alpha: 0.38 },
];
---

<footer class="footer">
  <div class="footer-main">
    <div class="logo-block">
      <p class="logo">
        <Icon name="iceCream" size={22} class="logo-icon" />
        Drum Ice
      </p>
      <p class="body-medium place">Heladería artesanal<br />Hurlingham, Buenos Aires</p>
      <p class="body-small note">
        Pedidos por WhatsApp<span class="visually-hidden"> al {PHONE.display}</span> · Retiro y envíos a zona Hurlingham
      </p>
    </div>

    <ul class="links" role="list">
      {
        links.map((l) => (
          <li>
            <a
              href={l.href}
              target="_blank"
              rel={l.wa ? 'noopener' : 'noopener noreferrer'}
              style={`--c:${l.color};--a:${l.alpha ?? 1}`}
              data-wa-source={l.wa ? 'footer' : undefined}
            >
              <Icon name={l.icon} size={15} />
              <span>{l.label}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>

  <QuarksFooter />
</footer>

<style>
  .footer {
    background: var(--dark-bg);
    padding: 48px 64px;
  }
  .footer-main {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 32px;
    margin-bottom: 48px;
  }
  .logo {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 22px;
    line-height: 1.3;
    color: #fff;
  }
  .logo :global(.logo-icon) {
    color: var(--pink);
  }
  .place {
    margin-top: 12px;
    color: rgb(255 255 255 / 0.38);
  }
  .note {
    margin-top: 20px;
    color: rgb(255 255 255 / 0.24);
  }
  .links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 10px;
  }
  .links a {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 16px;
    line-height: 1.6;
    color: rgb(var(--c) / calc(var(--a) * 0.7));
    transition: color 0.15s;
  }
  .links a :global(.icon) {
    color: rgb(var(--c) / calc(var(--a) * 0.6));
    transition: color 0.15s;
  }
  .links a:hover,
  .links a:hover :global(.icon) {
    color: rgb(var(--c) / var(--a));
  }

  @media (max-width: 639px) {
    .footer {
      padding: 48px 28px;
    }
    .footer-main {
      flex-direction: column;
      align-items: center;
      text-align: center;
    }
    .logo-block {
      display: flex;
      flex-direction: column;
      align-items: center;
    }
    .links {
      align-items: center;
    }
  }
</style>
