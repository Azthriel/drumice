---
import { Image, getImage } from 'astro:assets';
import Icon from './Icon.astro';
import { waLink } from '../lib/site';
import type { Promo } from '../lib/data';

interface Props {
  promos: Promo[];
}
const { promos } = Astro.props;

// Versión grande para el visor (pantalla completa).
const full = await Promise.all(
  promos.map((p) =>
    getImage({ src: p.url, width: Math.min(p.ancho, 1080), height: Math.round((Math.min(p.ancho, 1080) * p.alto) / p.ancho), format: 'webp' }),
  ),
);
---

<section id="promos" class="section promos">
  <div class="section-head">
    <h2 class="headline-large">Promociones</h2>
    <p class="body-large sub">Las ofertas del momento, para pedir por WhatsApp</p>
    <div class="accent-bar"></div>
  </div>

  <div class="carousel">
    <button class="nav prev" type="button" aria-label="Promo anterior" hidden>‹</button>
    <ul class="track" role="list">
      {
        promos.map((p, i) => (
          <li class="promo">
            <button
              type="button"
              class="promo-img"
              data-full={full[i].src}
              data-title={p.titulo}
              style={`aspect-ratio:${p.ancho} / ${p.alto}`}
              aria-label={`Ver promo en grande: ${p.titulo}`}
            >
              <Image
                src={p.url}
                width={p.ancho}
                height={p.alto}
                widths={[300, 450, 600, 900]}
                sizes="(max-width: 767px) 72vw, 300px"
                format="webp"
                loading={i < 2 ? 'eager' : 'lazy'}
                alt={p.titulo}
              />
            </button>
            <a
              href={waLink(`¡Hola Drum Ice! Vengo de la página y quiero la promo: ${p.titulo}`)}
              target="_blank"
              rel="noopener"
              class="btn promo-cta"
              data-wa-source="promos_section"
            >
              <Icon name="whatsapp" size={16} />
              Pedir esta promo
            </a>
          </li>
        ))
      }
    </ul>
    <button class="nav next" type="button" aria-label="Promo siguiente" hidden>›</button>
  </div>

  <dialog class="viewer" aria-label="Promo en grande">
    <button class="close" type="button" aria-label="Cerrar">
      <Icon name="xmark" size={22} />
    </button>
    <img alt="" />
  </dialog>
</section>

<style>
  .promos {
    background: var(--pale-blue);
    padding-left: 0;
    padding-right: 0;
  }
  .section-head {
    padding: 0 var(--gutter);
  }
  .sub {
    margin-top: 8px;
  }

  .carousel {
    position: relative;
    margin-top: 48px;
  }
  .track {
    list-style: none;
    margin: 0;
    padding: 12px var(--gutter) 24px;
    display: flex;
    gap: 24px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--gutter);
    scrollbar-width: none;
    justify-content: safe center;
  }
  .track::-webkit-scrollbar {
    display: none;
  }
  .promo {
    flex: 0 0 300px;
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }
  .promo-img {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    border-radius: 22px;
    overflow: hidden;
    cursor: zoom-in;
    background: var(--white);
    box-shadow: 0 8px 28px rgb(174 223 247 / 0.55);
    transition:
      transform 0.2s,
      box-shadow 0.2s;
  }
  .promo-img:hover {
    transform: translateY(-4px);
    box-shadow: 0 14px 34px rgb(255 174 207 / 0.45);
  }
  .promo-img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .promo-cta {
    background: var(--whatsapp);
    color: #fff;
    padding: 12px 22px;
    font-size: 16px;
  }
  .promo-cta:hover {
    background: #1fbe5b;
  }

  .nav {
    position: absolute;
    top: calc(50% - 40px);
    z-index: 2;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: 1.5px solid var(--pink);
    background: var(--white);
    color: var(--dark-brown);
    font-size: 30px;
    line-height: 1;
    cursor: pointer;
    box-shadow: 0 4px 12px rgb(0 0 0 / 0.08);
  }
  .nav:hover {
    background: var(--soft-pink);
  }
  .nav.prev {
    left: 20px;
  }
  .nav.next {
    right: 20px;
  }
  .nav[hidden] {
    display: none;
  }

  .viewer {
    padding: 0;
    border: 0;
    background: transparent;
    max-width: 100vw;
    max-height: 100vh;
    overflow: visible;
  }
  .viewer::backdrop {
    background: rgb(26 26 46 / 0.85);
  }
  .viewer img {
    max-width: min(92vw, 540px);
    max-height: 90vh;
    max-height: 90dvh;
    width: auto;
    height: auto;
    border-radius: 18px;
  }
  .close {
    position: absolute;
    top: -14px;
    right: -14px;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 0;
    background: var(--white);
    color: var(--dark-brown);
    display: grid;
    place-items: center;
    cursor: pointer;
    box-shadow: 0 4px 14px rgb(0 0 0 / 0.25);
  }

  @media (max-width: 767px) {
    .promo {
      flex-basis: 72vw;
      max-width: 300px;
    }
    .track {
      gap: 16px;
    }
    .nav {
      display: none !important;
    }
    .close {
      top: 8px;
      right: 8px;
    }
  }
</style>

<script>
  const section = document.querySelector<HTMLElement>('#promos');
  if (section) {
    const track = section.querySelector<HTMLElement>('.track')!;
    const prev = section.querySelector<HTMLButtonElement>('.nav.prev')!;
    const next = section.querySelector<HTMLButtonElement>('.nav.next')!;
    const dialog = section.querySelector<HTMLDialogElement>('.viewer')!;
    const img = dialog.querySelector('img')!;

    // Flechas solo si hay más promos de las que entran.
    const updateNav = () => {
      const overflow = track.scrollWidth > track.clientWidth + 4;
      prev.hidden = !overflow || track.scrollLeft < 8;
      next.hidden = !overflow || track.scrollLeft + track.clientWidth >= track.scrollWidth - 8;
    };
    const step = () => (track.querySelector('.promo')?.clientWidth ?? 300) + 24;
    prev.addEventListener('click', () => track.scrollBy({ left: -step(), behavior: 'smooth' }));
    next.addEventListener('click', () => track.scrollBy({ left: step(), behavior: 'smooth' }));
    track.addEventListener('scroll', updateNav, { passive: true });
    window.addEventListener('resize', updateNav);
    updateNav();

    // Visor en grande.
    section.querySelectorAll<HTMLButtonElement>('.promo-img').forEach((btn) => {
      btn.addEventListener('click', () => {
        img.src = btn.dataset.full!;
        img.alt = btn.dataset.title ?? '';
        dialog.showModal();
      });
    });
    dialog.querySelector('.close')!.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close(); // clic en el fondo
    });
  }
</script>
