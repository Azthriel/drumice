---
import Base from '../layouts/Base.astro';
import { waLink } from '../lib/site';
---

<Base title="404 - Página no encontrada | Drum Ice" path="/404" noindex>
  <main class="not-found">
    <div class="circle" aria-hidden="true">🏔️</div>

    <h1 class="code">404</h1>
    <h2 class="headline-medium">Esta isla no existe en el Grand Line</h2>
    <p class="body-large text">
      Parece que te perdiste navegando. La página que buscás no existe,<br class="br" />
      pero nuestros helados sí. 🍦
    </p>

    <div class="actions">
      <a href="/" class="btn btn-primary">
        <span aria-hidden="true">🏠</span> Volver al inicio
      </a>
      <a
        href={waLink('¡Hola Drum Ice! Me perdí buscando una página, pero quiero hacer un pedido.')}
        target="_blank"
        rel="noopener"
        class="btn btn-outline"
        data-wa-source="404_page"
      >
        <span aria-hidden="true">💬</span> Hacer un pedido
      </a>
    </div>
  </main>
</Base>

<style>
  .not-found {
    min-height: 100vh;
    min-height: 100svh;
    padding: 64px 80px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
  }
  .circle {
    width: 220px;
    height: 220px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    font-size: 90px;
    background: radial-gradient(circle, var(--soft-pink), var(--pale-pink));
    box-shadow: 0 0 60px 10px rgb(255 174 207 / 0.3);
  }
  .code {
    margin-top: 40px;
    font-size: 100px;
    line-height: 1.05;
    letter-spacing: -4px;
    color: var(--pink);
  }
  h2 {
    margin-top: 8px;
  }
  .text {
    margin-top: 16px;
  }
  .actions {
    margin-top: 48px;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px 16px;
  }
  .btn {
    font-size: 16px;
  }
  .btn span {
    font-size: 18px;
  }

  @media (max-width: 767px) {
    .not-found {
      padding: 64px 32px;
    }
    .circle {
      width: 180px;
      height: 180px;
      font-size: 72px;
    }
    .code {
      font-size: 80px;
    }
    .br {
      display: none;
    }
  }
</style>
