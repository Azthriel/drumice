---
import '../styles/global.css';
import { SITE } from '../lib/site';
import { firebaseConfig } from '../lib/firebase-config';

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  path?: string; // para el canonical
  noindex?: boolean;
  ogImage?: string;
  jsonLd?: Record<string, unknown>;
}

const {
  title = SITE.title,
  description = 'Drum Ice: heladería artesanal en Hurlingham inspirada en Drum Island de One Piece. Pedidos por WhatsApp. Retiro y envíos a zona Hurlingham, Buenos Aires.',
  keywords = 'helado artesanal, heladería Hurlingham, helados Hurlingham, pedidos WhatsApp, Drum Island, One Piece, helados Buenos Aires',
  path = '/',
  noindex = false,
  ogImage = '/og-image.png',
  jsonLd,
} = Astro.props;

const canonical = new URL(path, SITE.url).href.replace(/\/$/, '') || SITE.url;
const ogImageUrl = new URL(ogImage, SITE.url).href;
// En `astro dev` no se manda nada a GA para no ensuciar las métricas.
const gaId = import.meta.env.PROD ? firebaseConfig.measurementId : '';
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="Drum Ice" />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large'} />
    {!noindex && <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#FFAECF" />
    <meta name="generator" content={Astro.generator} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Drum Ice" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1254" />
    <meta property="og:image:height" content="1254" />
    <meta property="og:image:alt" content="Logo de Drum Ice, heladería artesanal" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Íconos y PWA -->
    <link rel="icon" type="image/png" sizes="192x192" href="/icons/Icon-192.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/icons/Icon-192.png" />
    <link rel="manifest" href="/manifest.json" />

    <link rel="preload" href="/fonts/BreeSerif-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="sitemap" href="/sitemap-index.xml" />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    <slot name="head" />

    {
      gaId && !noindex && (
        <>
          <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`} />
          <script is:inline define:vars={{ gaId }}>
            window.dataLayer = window.dataLayer || [];
            function gtag() { dataLayer.push(arguments); }
            window.gtag = gtag;
            gtag('js', new Date());
            gtag('config', gaId);
          </script>
        </>
      )
    }
  </head>
  <body>
    <slot />
    <script>
      import { initWhatsAppTracking } from '../scripts/analytics';
      initWhatsAppTracking();
    </script>
  </body>
</html>
